import geopandas as gpd
n_subtrees = gpd.read_parquet("data_working/detections_labeled.parquet")["subtree"].max()
subtrees = list(range(n_subtrees+1))

rule all:
    input:
        expand("data_working/eco_timeseries/timeseries-subtree-{subtree}.nc", subtree=subtrees)

rule process_tileset:
    output:
        "data_working/eco_timeseries/timeseries-subtree-{subtree}.nc"
    shell:
        "python scripts/process_ecostress_subtree.py --subtree {wildcards.subtree}"
