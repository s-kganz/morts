import geopandas as gpd
n_subtrees = gpd.read_parquet("data_working/detections_labeled.parquet")["subtree"].max()
subtrees = list(range(n_subtrees+1))

rule all:
    input:
        expand("data_working/s1_timeseries/timeseries-subtree-{subtree}.nc", subtree=subtrees)

rule process_tileset:
    output:
        "data_working/s1_timeseries/timeseries-subtree-{subtree}.nc"
    retries: 3
    resources:
        # Make retry attempt available
        attempt = lambda wildcards, attempt: attempt
    shell:
        """
        # Could through a sleep in here to slow down requests more.
        # Run the actual command
        python scripts/process_s1_subtree.py --subtree {wildcards.subtree}
        """
